{
  "author": "P&E VML Team",
  "license": "ISC",
  "homepage": "https://github.com/your-org/consent-manager#readme",
  "name": "@vml/consent-manager",
  "version": "1.0.0",
  "description": "Provider-agnostic consent management system for GDPR/CCPA cookie compliance",
  "main": "dist/ConsentWrapper.js",
  "types": "dist/ConsentWrapper.d.ts",
  "type": "module",
  "scripts": {
    "build": "npx tsc",
    "dev": "nodemon server.js",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage",
    "test:watch": "vitest --watch",
    "release:patch": "npm run _release patch",
    "release:minor": "npm run _release minor",
    "release:major": "npm run _release major",
    "_release": "sh ./release.sh",
    "version:show": "node -p \"require('./package.json').version\""
  },
  "keywords": [
    "consent",
    "cookie",
    "gdpr",
    "ccpa",
    "consent-management"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/vml/consent-manager.git"
  },
  "dependencies": {
    "express": "^5.1.0",
    "nodemon": "^3.1.10",
    "typescript": "^5.9.3"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "@vitest/coverage-v8": "^4.0.14",
    "@vitest/ui": "^4.0.14",
    "happy-dom": "^20.0.11",
    "vitest": "^4.0.14"
  }
}