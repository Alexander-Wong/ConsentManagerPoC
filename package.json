{
  "author": "P&E VML Team",
  "license": "ISC",
  "homepage": "https://github.com/your-org/consent-manager#readme",
  "name": "@vml/consent-manager",
  "version": "1.0.0",
  "description": "Provider-agnostic consent management system for GDPR/CCPA cookie compliance",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./types": {
      "import": "./dist/types/ConsentConfigJson.js",
      "types": "./dist/types/ConsentConfigJson.d.ts"
    }
  },
  "files": [
    "dist",
    "config",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "npx tsc",
    "build:bundle": "node ./packager/bundle.js",
    "dev": "nodemon server.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage",
    "test:watch": "vitest --watch",
    "release:patch": "npm run release patch",
    "release:minor": "npm run release minor",
    "release:major": "npm run release major",
    "release": "sh ./release.sh",
    "changelog:update": "conventional-changelog -p angular -i CHANGELOG.md -s -r 0",
    "version:show": "node -p \"require('./package.json').version\""
  },
  "keywords": [
    "consent",
    "cookie",
    "gdpr",
    "ccpa",
    "consent-management"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/Alexander-Wong/ConsentManagerPoC.git "
  },
  "dependencies": {
    "express": "^5.1.0",
    "nodemon": "^3.1.10",
    "typescript": "^5.9.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/eslint__js": "^8.42.3",
    "@types/node": "^24.10.1",
    "@vitest/coverage-v8": "^4.0.14",
    "@vitest/ui": "^4.0.14",
    "conventional-changelog-cli": "^5.0.0",
    "esbuild": "^0.27.0",
    "eslint": "^9.39.1",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import": "^2.32.0",
    "happy-dom": "^20.0.11",
    "typescript-eslint": "^8.48.1",
    "vitest": "^4.0.14"
  }
}
